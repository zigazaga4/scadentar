{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scadentar",
  "version": "0.1.0",
  "identifier": "ro.autolux.scadentar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scadențar — scadențe de plată",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "createUpdaterArtifacts": true,
    "shortDescription": "Alerte pentru facturile și ratele scadente din Excel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Romanian", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQzM4QjFCN0RBMkNCNjEKUldSaHk2SjlHNHZEejJSM05sYTB6TGlVL1pxQXoxdGxzRXJVZTZxT2FzS2xqQk1jRTFERDdZckUK",
      "endpoints": ["https://github.com/zigazaga4/scadentar/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
